<%# Reached when PasswordsController#edit finds no live token: the link expired,
    was already used, or was truncated by a mail client. Deliberately does not
    say which — an attacker with a guessed token learns nothing either way.

    The copy follows Figma frame 10, except the title, which that frame's export
    did not include; "Reset links are good for 6 hours" and "Send a new link"
    are the designer's. %>
<div class="auth-card">
  <div class="auth-badge auth-badge--warning">
    <%= render "shared/auth_icon", name: :clock, size: 28 %>
  </div>

  <h1 class="auth-card__title">This reset link has expired</h1>
  <p class="auth-card__subtitle">
    Reset links are good for 6 hours. Enter your email and we'll send you a new one.
  </p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
    <div class="auth-field">
      <%= f.label :email, "Email", class: "auth-field__label" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            placeholder: "you@example.com",
            class: "auth-input" %>
    </div>

    <%= f.submit "Send a new link", class: "auth-button" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
