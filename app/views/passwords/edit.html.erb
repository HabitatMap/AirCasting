<%# Rendered by PasswordsController (app/controllers/passwords_controller.rb),
    which takes view-lookup precedence over devise/passwords/.

    An expired or already-used token only surfaces here, on PUT: Devise does not
    check the token on GET. It lands in resource.errors[:reset_password_token],
    which belongs to a hidden field, so the summary banner is what surfaces it. %>
<div class="auth-card">
  <h1 class="auth-card__title">Choose a new password</h1>
  <p class="auth-card__subtitle">
    Pick a password you don't use anywhere else. You'll be signed in as soon as it's saved.
  </p>

  <%= render "shared/flash" %>

  <%= render "devise/shared/error_summary", resource: resource,
             inline_attributes: [:password, :password_confirmation],
             lead: "Your password couldn't be saved. Check the two fields below." %>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <div class="auth-field">
      <%= f.label :password, "New password", class: "auth-field__label" %>
      <%= f.password_field :password,
            autofocus: true,
            autocomplete: "new-password",
            placeholder: "Enter a new password",
            class: "auth-input",
            "aria-invalid": resource.errors[:password].any?.to_s,
            "aria-describedby": [("password_error" if resource.errors[:password].any?), "password_hint"].compact.join(" ") %>
      <% if @minimum_password_length %>
        <p class="auth-field__hint" id="password_hint">At least <%= @minimum_password_length %> characters.</p>
      <% end %>
      <%= render "devise/shared/field_error", resource: resource, attribute: :password %>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation, "Confirm new password", class: "auth-field__label" %>
      <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            placeholder: "Type it once more",
            class: "auth-input",
            "aria-invalid": resource.errors[:password_confirmation].any?.to_s,
            "aria-describedby": (resource.errors[:password_confirmation].any? ? "password_confirmation_error" : nil) %>
      <%= render "devise/shared/field_error", resource: resource, attribute: :password_confirmation %>
    </div>

    <%= f.submit "Change my password", class: "auth-button" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
