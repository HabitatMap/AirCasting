<%# No Figma frame exists for this screen, so it is assembled from the same kit
    as the others. Fields are exactly the ones the previous template had.
    The `devise_mapping.confirmable?` branch that used to sit under the email
    field is gone: the User model does not enable :confirmable, so it could
    never render. %>
<div class="auth-card">
  <h1 class="auth-card__title">Your account</h1>
  <p class="auth-card__subtitle">
    Update your email or change your password. Leave the password fields blank to keep your current one.
  </p>

  <%= render "shared/flash" %>

  <%= render "devise/shared/error_summary", resource: resource,
             inline_attributes: [:email, :password, :password_confirmation, :current_password],
             lead: "We couldn't save your changes. Check the fields below." %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
    <div class="auth-field">
      <%= f.label :email, "Email", class: "auth-field__label" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "auth-input",
            "aria-invalid": resource.errors[:email].any?.to_s,
            "aria-describedby": (resource.errors[:email].any? ? "email_error" : nil) %>
      <%= render "devise/shared/field_error", resource: resource, attribute: :email %>
    </div>

    <div class="auth-field">
      <%= f.label :password, "New password", class: "auth-field__label" %>
      <%= f.password_field :password,
            autocomplete: "new-password",
            placeholder: "Leave blank to keep your current password",
            class: "auth-input",
            "aria-invalid": resource.errors[:password].any?.to_s,
            "aria-describedby": [("password_error" if resource.errors[:password].any?), "password_hint"].compact.join(" ") %>
      <% if @minimum_password_length %>
        <p class="auth-field__hint" id="password_hint">At least <%= @minimum_password_length %> characters.</p>
      <% end %>
      <%= render "devise/shared/field_error", resource: resource, attribute: :password %>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation, "Confirm new password", class: "auth-field__label" %>
      <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "auth-input",
            "aria-invalid": resource.errors[:password_confirmation].any?.to_s,
            "aria-describedby": (resource.errors[:password_confirmation].any? ? "password_confirmation_error" : nil) %>
      <%= render "devise/shared/field_error", resource: resource, attribute: :password_confirmation %>
    </div>

    <div class="auth-field">
      <%= f.label :current_password, "Current password", class: "auth-field__label" %>
      <%= f.password_field :current_password,
            autocomplete: "current-password",
            class: "auth-input",
            "aria-invalid": resource.errors[:current_password].any?.to_s,
            "aria-describedby": [("current_password_error" if resource.errors[:current_password].any?), "current_password_hint"].compact.join(" ") %>
      <p class="auth-field__hint" id="current_password_hint">We need your current password to confirm your changes.</p>
      <%= render "devise/shared/field_error", resource: resource, attribute: :current_password %>
    </div>

    <%= f.submit "Update", class: "auth-button" %>
  <% end %>

  <hr class="auth-card__divider" />

  <h2 class="auth-card__section-title">Cancel my account</h2>
  <p class="auth-card__subtitle">This deletes your account and everything on it. It cannot be undone.</p>
  <%= button_to "Cancel my account", registration_path(resource_name),
        method: :delete,
        form_class: "auth-form",
        class: "auth-button auth-button--danger",
        data: { confirm: "Are you sure?" } %>

  <%= link_to "Back", :back, class: "auth-link auth-link--back" %>
</div>
